@baseUrl = http://localhost:5198

# Run these top to bottom while the service is running (F5).
# In Visual Studio, click "Send request" above each one; the response opens on the right.
#
# The Prior Authorization API takes a SMART Backend Services token. Sign a client assertion with the sample
# client's (synthetic, published) key and paste it below, then send step A; every later request carries the token
# it returns. An assertion is good once and for a few minutes, so run the script again when step A says
# "already been presented" or the token expires (five minutes).
#
#     ./samples/New-ClientAssertion.ps1
#
# To try the service without tokens instead, set Authentication:Enabled to false in appsettings.json.
@clientAssertion = PASTE-THE-SCRIPT-OUTPUT-HERE

### A. The provider system trades its signed client assertion for an access token.
# Expect: 200 with access_token, token_type "bearer", expires_in 300 and the scopes granted.
# A bad signature, an unknown client or a replayed assertion give 400 with error "invalid_client".
# @name token
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer&client_assertion={{clientAssertion}}&scope=system/Claim.read system/Claim.write system/Subscription.write

### B. What the service advertises about obtaining a token (no token needed).
GET {{baseUrl}}/.well-known/smart-configuration

### 0. CRD: the EHR asks, as the clinician signs the order, whether prior authorization is needed.
# Expect: 200 with one systemAction of type "update" carrying the ServiceRequest back with a
# coverage-information extension whose "pa-needed" is "auth-needed" (change H0019 to H0004 for "no-auth").
POST {{baseUrl}}/cds-services/order-sign-crd
Content-Type: application/json
Authorization: Bearer {{token.response.body.$.access_token}}

{
  "hookInstance": "d1577c69-dfbe-44ad-ba6d-3e05e953b2ea",
  "fhirServer": "http://example.org/ehr/fhir",
  "hook": "order-sign",
  "context": {
    "userId": "PractitionerRole/ReferringClinician",
    "patientId": "MemberExample",
    "draftOrders": {
      "resourceType": "Bundle",
      "type": "collection",
      "entry": [
        {
          "resource": {
            "resourceType": "ServiceRequest",
            "id": "ResidentialOrder",
            "status": "draft",
            "intent": "order",
            "code": { "coding": [{ "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets", "code": "H0019" }] },
            "orderDetail": [{ "coding": [{ "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets", "code": "U1" }] }],
            "subject": { "reference": "Patient/MemberExample" },
            "authoredOn": "2026-11-06",
            "insurance": [{ "reference": "Coverage/MemberCoverage" }]
          }
        }
      ]
    }
  },
  "prefetch": {
    "patient": {
      "resourceType": "Patient",
      "id": "MemberExample",
      "identifier": [{ "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] }, "value": "90000001A" }]
    },
    "coverage": {
      "resourceType": "Coverage",
      "id": "MemberCoverage",
      "status": "active",
      "subscriberId": "90000001A",
      "beneficiary": { "reference": "Patient/MemberExample" },
      "payor": [{ "display": "SYNTHETIC BEHAVIORAL HEALTH PLAN" }]
    }
  }
}

### 1. Provider submits a residential treatment request (H0019 + U1).
# Without the Authorization header the answer is 401 with an OperationOutcome.
# Expect: 200, and in the ClaimResponse item a review action code of "A4" (Pended)
# with an administrationReferenceNumber starting "PEND-".
# Each send uses a new bundle identifier, so each send creates a new request.
# @name submit
POST {{baseUrl}}/fhir/Claim/$submit
Content-Type: application/fhir+json
Authorization: Bearer {{token.response.body.$.access_token}}

{
  "resourceType": "Bundle",
  "meta": { "profile": ["http://hl7.org/fhir/us/davinci-pas/StructureDefinition/profile-pas-request-bundle"] },
  "identifier": { "system": "http://example.org/SUBMITTER_TRANSACTION_IDENTIFIER", "value": "demo-{{$timestamp}}" },
  "type": "collection",
  "timestamp": "2026-11-06T09:59:00-08:00",
  "entry": [
    {
      "fullUrl": "http://example.org/fhir/Claim/ResidentialRequest",
      "resource": {
        "resourceType": "Claim",
        "id": "ResidentialRequest",
        "identifier": [{ "system": "http://example.org/PATIENT_EVENT_TRACE_NUMBER", "value": "demo-{{$timestamp}}" }],
        "status": "active",
        "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "institutional" }] },
        "use": "preauthorization",
        "patient": { "reference": "Patient/MemberExample" },
        "created": "2026-11-06T09:59:00-08:00",
        "insurer": { "reference": "Organization/BehavioralHealthPlan" },
        "provider": { "reference": "Organization/TreatmentProvider" },
        "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/processpriority", "code": "normal" }] },
        "insurance": [{ "sequence": 1, "focal": true, "coverage": { "reference": "Coverage/MemberCoverage" } }],
        "item": [
          {
            "extension": [
              { "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-serviceItemRequestType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1525", "code": "HS", "display": "Health Services Review" }] } },
              { "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-certificationType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1322", "code": "I", "display": "Initial" }] } }
            ],
            "sequence": 1,
            "category": { "coding": [{ "system": "https://codesystem.x12.org/005010/1365", "code": "AI", "display": "Substance Abuse" }] },
            "productOrService": { "coding": [{ "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets", "code": "H0019" }] },
            "modifier": [{ "coding": [{ "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets", "code": "U1" }] }],
            "locationCodeableConcept": { "coding": [{ "system": "https://www.cms.gov/Medicare/Coding/place-of-service-codes/Place_of_Service_Code_Set", "code": "55" }] }
          }
        ]
      }
    },
    {
      "fullUrl": "http://example.org/fhir/Organization/TreatmentProvider",
      "resource": { "resourceType": "Organization", "id": "TreatmentProvider", "active": true, "name": "SYNTHETIC RECOVERY HOUSE" }
    },
    {
      "fullUrl": "http://example.org/fhir/Organization/BehavioralHealthPlan",
      "resource": { "resourceType": "Organization", "id": "BehavioralHealthPlan", "active": true, "name": "SYNTHETIC BEHAVIORAL HEALTH PLAN" }
    },
    {
      "fullUrl": "http://example.org/fhir/Coverage/MemberCoverage",
      "resource": {
        "resourceType": "Coverage",
        "id": "MemberCoverage",
        "identifier": [{ "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] }, "system": "http://example.org/fhir/sid/member-identifier", "value": "90000001A" }],
        "status": "active",
        "subscriberId": "90000001A",
        "subscriber": { "reference": "Patient/MemberExample" },
        "beneficiary": { "reference": "Patient/MemberExample" },
        "relationship": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/subscriber-relationship", "code": "self" }] },
        "payor": [{ "reference": "Organization/BehavioralHealthPlan" }]
      }
    },
    {
      "fullUrl": "http://example.org/fhir/Patient/MemberExample",
      "resource": {
        "resourceType": "Patient",
        "id": "MemberExample",
        "identifier": [
          {
            "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] },
            "system": "http://example.org/fhir/sid/member-identifier",
            "value": "90000001A"
          }
        ],
        "name": [{ "family": "EXAMPLE", "given": ["ALEX"] }],
        "gender": "female"
      }
    }
  ]
}

### 1b. (Optional) Provider system subscribes to decisions for its organization (NPI 8189991234).
# Expect: 201 with the Subscription echoed back as "active". After step 3a or 3b the service POSTs a
# history Bundle (subscription status + the PAS response) to the endpoint below; point it at a listener
# such as https://webhook.site to see it arrive. Without the org-identifier filter the answer is 422.
POST {{baseUrl}}/fhir/Subscription
Content-Type: application/fhir+json
Authorization: Bearer {{token.response.body.$.access_token}}

{
  "resourceType": "Subscription",
  "status": "requested",
  "reason": "Monitor PAS authorization notifications via REST hook",
  "criteria": "http://hl7.org/fhir/us/davinci-pas/SubscriptionTopic/PASSubscriptionTopic",
  "_criteria": {
    "extension": [
      {
        "url": "http://hl7.org/fhir/uv/subscriptions-backport/StructureDefinition/backport-filter-criteria",
        "valueString": "org-identifier=8189991234"
      }
    ]
  },
  "channel": {
    "type": "rest-hook",
    "endpoint": "http://localhost:9999/api/pas/notification",
    "payload": "application/fhir+json"
  }
}

### 2. Reviewer lists the Pended requests.
# A Reviewer would normally do steps 2 and 3 on the page at {{baseUrl}}/reviewer, which calls these same
# endpoints; the raw requests are here to see the wire shapes.
# Expect: the request from step 1, with serviceCodes ["H0019"], decisionDeadline 24 hours after receivedAt
# and overdue false. (A request may carry several items; only the ones needing review are listed here.)
GET {{baseUrl}}/reviewer/pended-requests

### 2b. The coded Denial Reasons the page offers in its picker.
# Expect: 200 with the codes under PriorAuthorization:DenialReasonCodes in appsettings.json; [] until the plan
# enters its licensed X12 886 codes, and then the page hides the picker.
GET {{baseUrl}}/reviewer/denial-reason-codes

### 3a. Reviewer approves the request from step 1 (or does it on the page at {{baseUrl}}/reviewer).
# Expect: 204. Sending it a second time gives 409, because the request is already decided.
# Remove the body's date to see the 400 for a missing end date.
POST {{baseUrl}}/reviewer/requests/{{submit.response.body.$.entry[0].resource.id}}/approve
Content-Type: application/json

{ "authorizationEnds": "2026-12-06" }

### 3b. OR the Reviewer denies it, here or on the page (send step 1 again first to get a fresh Pended request).
# Expect: 204. An empty reason gives 400. A "reasonCode" may be added once the plan has entered its licensed
# X12 886 codes under PriorAuthorization:DenialReasonCodes in appsettings.json; an unknown code gives 400.
POST {{baseUrl}}/reviewer/requests/{{submit.response.body.$.entry[0].resource.id}}/deny
Content-Type: application/json

{ "denialReason": "The assessment does not show a need for a residential level of care." }

### 4. Provider asks what became of the Member's requests.
# Expect: 200, a Parameters resource with one "responseBundle" per request for Member 90000001A.
# An approved one shows review action "A1", a "number" starting "AUTH-" and an itemPreAuthPeriod ending 2026-12-06.
# A denied one shows "A2" and the reason under processNote. A Pended one shows "A4".
POST {{baseUrl}}/fhir/Claim/$inquire
Content-Type: application/fhir+json
Authorization: Bearer {{token.response.body.$.access_token}}

{
  "resourceType": "Bundle",
  "meta": { "profile": ["http://hl7.org/fhir/us/davinci-pas/StructureDefinition/profile-pas-inquiry-request-bundle"] },
  "identifier": { "system": "http://example.org/SUBMITTER_TRANSACTION_IDENTIFIER", "value": "inquiry-{{$timestamp}}" },
  "type": "collection",
  "timestamp": "2026-11-06T12:00:00-08:00",
  "entry": [
    {
      "fullUrl": "http://example.org/fhir/Claim/Inquiry",
      "resource": {
        "resourceType": "Claim",
        "id": "Inquiry",
        "identifier": [{ "system": "http://example.org/PATIENT_EVENT_TRACE_NUMBER", "value": "111099" }],
        "status": "active",
        "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "institutional" }] },
        "use": "preauthorization",
        "patient": { "reference": "Patient/MemberExample" },
        "created": "2026-11-06T12:00:00-08:00",
        "insurer": { "reference": "Organization/BehavioralHealthPlan" },
        "provider": { "reference": "Organization/TreatmentProvider" },
        "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/processpriority", "code": "normal" }] },
        "insurance": [{ "sequence": 1, "focal": true, "coverage": { "reference": "Coverage/MemberCoverage" } }]
      }
    },
    {
      "fullUrl": "http://example.org/fhir/Organization/TreatmentProvider",
      "resource": { "resourceType": "Organization", "id": "TreatmentProvider", "active": true, "name": "SYNTHETIC RECOVERY HOUSE" }
    },
    {
      "fullUrl": "http://example.org/fhir/Organization/BehavioralHealthPlan",
      "resource": { "resourceType": "Organization", "id": "BehavioralHealthPlan", "active": true, "name": "SYNTHETIC BEHAVIORAL HEALTH PLAN" }
    },
    {
      "fullUrl": "http://example.org/fhir/Coverage/MemberCoverage",
      "resource": {
        "resourceType": "Coverage",
        "id": "MemberCoverage",
        "identifier": [{ "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] }, "system": "http://example.org/fhir/sid/member-identifier", "value": "90000001A" }],
        "status": "active",
        "subscriberId": "90000001A",
        "subscriber": { "reference": "Patient/MemberExample" },
        "beneficiary": { "reference": "Patient/MemberExample" },
        "relationship": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/subscriber-relationship", "code": "self" }] },
        "payor": [{ "reference": "Organization/BehavioralHealthPlan" }]
      }
    },
    {
      "fullUrl": "http://example.org/fhir/Patient/MemberExample",
      "resource": {
        "resourceType": "Patient",
        "id": "MemberExample",
        "identifier": [
          {
            "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] },
            "system": "http://example.org/fhir/sid/member-identifier",
            "value": "90000001A"
          }
        ],
        "name": [{ "family": "EXAMPLE", "given": ["ALEX"] }],
        "gender": "female"
      }
    }
  ]
}

### 5. The public prior authorization metrics for a calendar year.
# Expect: 200 with counts of requests that needed a decision, approved/denied percentages and the
# average and median hours to a decision. Without ?year= the report is for last year.
GET {{baseUrl}}/reports/prior-authorization-metrics?year=2026

### 6. Provider cancels the request from step 1 (while it is Pended, or after approval).
# Expect: 200 with every item "A2" and a process note "Cancelled at the provider's request"; the request
# leaves the Reviewer's list. Cancelling a denied request gives 400. An update is the same Bundle without
# the certificationType extension, carrying the new items (withdrawn ones with the infoCancelled modifier extension).
POST {{baseUrl}}/fhir/Claim/$submit
Content-Type: application/fhir+json
Authorization: Bearer {{token.response.body.$.access_token}}

{
  "resourceType": "Bundle",
  "identifier": { "system": "http://example.org/SUBMITTER_TRANSACTION_IDENTIFIER", "value": "cancel-{{$timestamp}}" },
  "type": "collection",
  "timestamp": "2026-11-06T12:00:00-08:00",
  "entry": [
    {
      "fullUrl": "http://example.org/fhir/Claim/CancelRequest",
      "resource": {
        "resourceType": "Claim",
        "id": "CancelRequest",
        "extension": [{ "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-certificationType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1322", "code": "3" }] } }],
        "identifier": [{ "system": "http://example.org/PATIENT_EVENT_TRACE_NUMBER", "value": "cancel-{{$timestamp}}" }],
        "related": [{ "claim": { "reference": "Claim/PriorRequest" }, "relationship": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/ex-relatedclaimrelationship", "code": "prior" }] } }],
        "status": "active",
        "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "institutional" }] },
        "use": "preauthorization",
        "patient": { "reference": "Patient/MemberExample" },
        "created": "2026-11-06T12:00:00-08:00",
        "insurer": { "reference": "Organization/BehavioralHealthPlan" },
        "provider": { "reference": "Organization/TreatmentProvider" },
        "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/processpriority", "code": "normal" }] },
        "insurance": [{ "sequence": 1, "focal": true, "coverage": { "reference": "Coverage/MemberCoverage" } }],
        "item": [{ "extension": [{ "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-serviceItemRequestType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1525", "code": "HS", "display": "Health Services Review" }] } }, { "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-certificationType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1322", "code": "I", "display": "Initial" }] } }], "sequence": 1, "category": { "coding": [{ "system": "https://codesystem.x12.org/005010/1365", "code": "AI" }] }, "productOrService": { "coding": [{ "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets", "code": "H0019" }] }, "locationCodeableConcept": { "coding": [{ "system": "https://www.cms.gov/Medicare/Coding/place-of-service-codes/Place_of_Service_Code_Set", "code": "55" }] } }]
      }
    },
    {
      "fullUrl": "http://example.org/fhir/Claim/PriorRequest",
      "resource": {
        "resourceType": "Claim",
        "id": "PriorRequest",
        "identifier": [{ "system": "http://example.org/PATIENT_EVENT_TRACE_NUMBER", "value": "{{submit.request.body.$.identifier.value}}" }],
        "status": "active",
        "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "institutional" }] },
        "use": "preauthorization",
        "patient": { "reference": "Patient/MemberExample" },
        "created": "2026-11-06T09:59:00-08:00",
        "insurer": { "reference": "Organization/BehavioralHealthPlan" },
        "provider": { "reference": "Organization/TreatmentProvider" },
        "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/processpriority", "code": "normal" }] },
        "insurance": [{ "sequence": 1, "focal": true, "coverage": { "reference": "Coverage/MemberCoverage" } }],
        "item": [{ "extension": [{ "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-serviceItemRequestType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1525", "code": "HS", "display": "Health Services Review" }] } }, { "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-certificationType", "valueCodeableConcept": { "coding": [{ "system": "https://codesystem.x12.org/005010/1322", "code": "I", "display": "Initial" }] } }], "sequence": 1, "category": { "coding": [{ "system": "https://codesystem.x12.org/005010/1365", "code": "AI" }] }, "productOrService": { "coding": [{ "system": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets", "code": "H0019" }] }, "locationCodeableConcept": { "coding": [{ "system": "https://www.cms.gov/Medicare/Coding/place-of-service-codes/Place_of_Service_Code_Set", "code": "55" }] } }]
      }
    },
    { "fullUrl": "http://example.org/fhir/Organization/TreatmentProvider", "resource": { "resourceType": "Organization", "id": "TreatmentProvider", "identifier": [{ "system": "http://hl7.org/fhir/sid/us-npi", "value": "8189991234" }], "active": true, "name": "SYNTHETIC RECOVERY HOUSE" } },
    { "fullUrl": "http://example.org/fhir/Organization/BehavioralHealthPlan", "resource": { "resourceType": "Organization", "id": "BehavioralHealthPlan", "identifier": [{ "system": "http://hl7.org/fhir/sid/us-npi", "value": "1234567893" }], "active": true, "name": "SYNTHETIC BEHAVIORAL HEALTH PLAN" } },
    { "fullUrl": "http://example.org/fhir/Coverage/MemberCoverage", "resource": { "resourceType": "Coverage", "id": "MemberCoverage", "identifier": [{ "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] }, "system": "http://example.org/fhir/sid/member-identifier", "value": "90000001A" }], "status": "active", "subscriberId": "90000001A", "subscriber": { "reference": "Patient/MemberExample" }, "beneficiary": { "reference": "Patient/MemberExample" }, "relationship": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/subscriber-relationship", "code": "self" }] }, "payor": [{ "reference": "Organization/BehavioralHealthPlan" }] } },
    { "fullUrl": "http://example.org/fhir/Patient/MemberExample", "resource": { "resourceType": "Patient", "id": "MemberExample", "identifier": [{ "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MB" }] }, "system": "http://example.org/fhir/sid/member-identifier", "value": "90000001A" }], "name": [{ "family": "EXAMPLE", "given": ["ALEX"] }], "gender": "female" } }
